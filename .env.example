# MimicBot — copy this file to `.env`, fill in real values, then run: python bot.py

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Any OpenRouter model id (swap anytime — DeepSeek, Llama, Gemini, Claude, etc.)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional. Leave blank to use the built-in default personality.
BOT_PERSONALITY=

# Optional: custom SQLite path (default: ./mimicbot.db next to bot.py)
# MIMICBOT_DB=mimicbot.db
